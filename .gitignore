# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Virtual env / package manager ---
.venv/
venv/
env/
# .python-version is intentionally NOT ignored: uv reads it on `uv sync` so cloners
# get the right interpreter. Commit it.

# --- Type / lint / test caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Claude Code user-local state (project-shared settings.json IS commitable) ---
.claude/settings.local.json
.claude/worktrees/

# --- Logs ---
*.log

# --- Hydra per-run output (timestamped working dirs) ---
outputs/

# --- Trained weights (large; host on HF Hub or GitHub releases instead) ---
checkpoints/
*.pth

# --- Run artifacts under results/ ---
# These are regenerated by `python -m src.evaluate` and bloat the repo.
# What IS committed: metrics.json, per_image_metrics.json, train_log.csv,
# train_summary.json, confusion_matrix_*.png — small files the README links to.
results/*/error_maps/
results/*/predictions_*/
results/*/train_stdout.log

# --- Data files (large; populate locally per data/README.md) ---
data/**/*.tif
data/**/*.tiff
data/**/*.png
data/**/*.jp2
data/**/*.zip
